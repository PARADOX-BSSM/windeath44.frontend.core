{
  "name": "windeath44",
  "version": "0.1.0",
  "description": "Web-based OS architecture library for TypeScript + React",
  "license": "MIT",
  "author": "PARADOX-BSSM",
  "repository": {
    "type": "git",
    "url": "https://github.com/PARADOX-BSSM/windeath44.frontend.core.git"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs",
      "types": "./dist/react/index.d.ts"
    },
    "./window": {
      "import": "./dist/window/index.js",
      "require": "./dist/window/index.cjs",
      "types": "./dist/window/index.d.ts"
    },
    "./shell": {
      "import": "./dist/shell/index.js",
      "require": "./dist/shell/index.cjs",
      "types": "./dist/shell/index.d.ts"
    },
    "./router": {
      "import": "./dist/router/index.js",
      "require": "./dist/router/index.cjs",
      "types": "./dist/router/index.d.ts"
    },
    "./vfs": {
      "import": "./dist/vfs/index.js",
      "require": "./dist/vfs/index.cjs",
      "types": "./dist/vfs/index.d.ts"
    },
    "./notifications": {
      "import": "./dist/notifications/index.js",
      "require": "./dist/notifications/index.cjs",
      "types": "./dist/notifications/index.d.ts"
    },
    "./context-menu": {
      "import": "./dist/context-menu/index.js",
      "require": "./dist/context-menu/index.cjs",
      "types": "./dist/context-menu/index.d.ts"
    },
    "./drag-drop": {
      "import": "./dist/drag-drop/index.js",
      "require": "./dist/drag-drop/index.cjs",
      "types": "./dist/drag-drop/index.d.ts"
    },
    "./pdui": {
      "import": "./dist/pdui/index.js",
      "require": "./dist/pdui/index.cjs",
      "types": "./dist/pdui/index.d.ts"
    },
    "./ssr": {
      "import": "./dist/ssr/index.js",
      "require": "./dist/ssr/index.cjs",
      "types": "./dist/ssr/index.d.ts"
    },
    "./theme": {
      "import": "./dist/theme/index.js",
      "require": "./dist/theme/index.cjs",
      "types": "./dist/theme/index.d.ts"
    },
    "./keyboard": {
      "import": "./dist/keyboard/index.js",
      "require": "./dist/keyboard/index.cjs",
      "types": "./dist/keyboard/index.d.ts"
    },
    "./clipboard": {
      "import": "./dist/clipboard/index.js",
      "require": "./dist/clipboard/index.cjs",
      "types": "./dist/clipboard/index.d.ts"
    },
    "./app-registry": {
      "import": "./dist/app-registry/index.js",
      "require": "./dist/app-registry/index.cjs",
      "types": "./dist/app-registry/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.1"
  }
}
